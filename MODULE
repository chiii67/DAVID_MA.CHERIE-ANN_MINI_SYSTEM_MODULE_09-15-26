#HELPER FUNCTIONS (used throughtout the program
def get_float(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return float(input)
        except ValueError:
            print("  >> Invalid input received. Existing program.")
            raise SystemExit
def get_int(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return int (input())
        except ValueError:
            print(" >>Invalid input. Please type a whole number(e.g., 5, -3, 0).")
            except EOFError:
                print("\n >> No input received. Existing program>")
                raise SystemExit

